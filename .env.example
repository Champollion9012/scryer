# Copy this file to .env and fill in your values.

# ==========================================================================
# LLM Providers (audit_contracts.py)
# ==========================================================================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional cost-tracking (USD per 1K tokens)
OPENAI_PRICE_IN_PER_1K=
OPENAI_PRICE_OUT_PER_1K=

# Optional: Claude / Gemini providers
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ==========================================================================
# Block Explorer API Keys (contract_crawler.py, download_contract.py)
# ==========================================================================
BSCSCAN_API_KEY=
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_API_KEY=
SNOWTRACE_API_KEY=
FTMSCAN_API_KEY=
BASESCAN_API_KEY=

# ==========================================================================
# RPC Endpoints  (resolved by scryer_config.get_rpc_url / get_rpc_urls)
# ==========================================================================
# ONE convention for every module (download_contract, data_sources, and
# rpc_contract_discovery all share it):
#   * Per-chain  <CHAIN>_URL  is the primary — ETH_URL / BSC_URL / POLYGON_URL /
#     ARB_URL / OPTIMISM_URL / BASE_URL / FANTOM_URL / AVALANCHE_URL.
#   * Each value may be a comma- OR whitespace/newline-separated list; the FIRST
#     entry is the primary, the rest are fallbacks (used round-robin in discovery).
#   * A public endpoint is auto-appended, so a chain always resolves to something.
#   * RPC_URL (no chain) is an optional generic fallback for any chain.
ALCHEMY_KEY=YOUR_KEY_HERE
ETH_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
BSC_URL=https://bnb-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY},https://bsc-dataseed.binance.org
POLYGON_URL=https://polygon-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
ARB_URL=https://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}
# RPC_URL=https://your-generic-fallback-node

# ==========================================================================
# Optional
# ==========================================================================
# SOCKS proxy fallback for rate-limited requests
# SOCKS_PROXY=socks5://127.0.0.1:1080

# Decompiler (decompilers.py) — path to Heimdall binary, accessed via WSL on Windows
# HEIMDALL_PATH=/home/j/.bifrost/bin/heimdall

# Similarity model override (similarity.py)
# SIMILARITY_MODEL=microsoft/graphcodebert-base

# Default contract for ad-hoc download_contract.py runs
# CONTRACT_ADDRESS=0x...
